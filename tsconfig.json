{
  "extends": "./.svelte-kit/tsconfig.json",
  "compilerOptions": {
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "target": "ESNext",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "noImplicitReturns": true,
    "allowSyntheticDefaultImports": true,
    // kokoro-js + @huggingface/transformers ship type definitions that don't
    // pass strict — skip checking node_modules .d.ts files (our own code is
    // still strict-checked).
    "skipLibCheck": true
  }
}
