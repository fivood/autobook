{
  "name": "AutoBook",
  "short_name": "AutoBook",
  "description": "逐字浮现的阅读节奏，跨设备同步阅读时长。",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "orientation": "portrait",
  "background_color": "#f0efe6",
  "theme_color": "#5f7e7b",
  "lang": "zh-CN",
  "share_target": {
    "method": "POST",
    "enctype": "multipart/form-data",
    "action": "/share-target",
    "params": {
      "files": [
        {
          "name": "file",
          "accept": [
            "application/epub+zip",
            "application/pdf",
            "text/plain",
            "text/markdown"
          ]
        }
      ]
    }
  },
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any"
    },
    {
      "src": "/maskable-icon-192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "maskable"
    },
    {
      "src": "/maskable-icon-512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ]
}
