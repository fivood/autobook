{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "AutoBook",
  "version": "1.0.11",
  "identifier": "io.github.fukki.ebookreader",
  "build": {
    "frontendDist": "../build",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "AutoBook v1.0.11",
        "width": 1280,
        "height": 860,
        "resizable": true,
        "fullscreen": false,
        "additionalBrowserArgs": "--disk-cache-size=1"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "debugApplicationIdSuffix": ".debug"
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "dialog": false,
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZDOUI5RDNGQzRGMDUwClJXUlE4TVEvblp2OEFKZlJpQWNubU5TUEc0REtRQ1NiWXMzRG9xU1N0N1BqbUJuWGp5TW9YY1F4Cg==",
      "endpoints": [
        "https://updates.fivood.com/latest.json",
        "https://github.com/fivood/autobook/releases/latest/download/latest.json"
      ]
    }
  }
}
